<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- BOX -->
  <!-- params: mass, size="x y z", xyz(optional), rpy(optional) -->
  <xacro:macro name="box_inertial" params="mass size xyz:='0 0 0' rpy:='0 0 0'">
    <xacro:property name="x" value="${size.split()[0]}" />
    <xacro:property name="y" value="${size.split()[1]}" />
    <xacro:property name="z" value="${size.split()[2]}" />

    <inertial>
      <origin
        xyz="${xyz}" rpy="${rpy}" />
      <mass value="${mass}" />
      <inertia
        ixx="${mass * (y*y + z*z) / 12.0}"
        iyy="${mass * (x*x + z*z) / 12.0}"
        izz="${mass * (x*x + y*y) / 12.0}"
        ixy="0.0" ixz="0.0" iyz="0.0" />
    </inertial>
  </xacro:macro>


  <!-- SPHERE -->
  <!-- params: mass, radius, xyz(optional), rpy(optional) -->
  <xacro:macro name="sphere_inertial" params="mass radius xyz:='0 0 0' rpy:='0 0 0'">
    <inertial>
      <origin
        xyz="${xyz}" rpy="${rpy}" />
      <mass
        value="${mass}" />
      <inertia
        ixx="${0.4 * mass * radius*radius}"
        iyy="${0.4 * mass * radius*radius}"
        izz="${0.4 * mass * radius*radius}"
        ixy="0.0" ixz="0.0" iyz="0.0" />
    </inertial>
  </xacro:macro>


  <!-- CYLINDER -->
  <!-- params: mass, radius, length, xyz(optional), rpy(optional) -->
  <!-- Asumsi sumbu silinder = Z -->
  <xacro:macro name="cylinder_inertial" params="mass radius length xyz:='0 0 0' rpy:='0 0 0'">
    <inertial>
      <origin
        xyz="${xyz}" rpy="${rpy}" />
      <mass
        value="${mass}" />
      <inertia
        ixx="${mass * (3*radius*radius + length*length) / 12.0}"
        iyy="${mass * (3*radius*radius + length*length) / 12.0}"
        izz="${0.5 * mass * radius*radius}"
        ixy="0.0" ixz="0.0" iyz="0.0" />
    </inertial>
  </xacro:macro>

</robot>
